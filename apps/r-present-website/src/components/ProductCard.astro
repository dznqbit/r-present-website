---
import { responsiveImage } from "../lib/images";
import type { Product } from "../lib/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, available, images, price } = product.data;
// No photo yet: the image box stays empty (grey) instead of a broken image.
const thumbnail = images[0];
---

<a class="product-card" href={`/products/${product.id}`}>
  <div class="card-image">
    {
      thumbnail && (
        <img
          {...responsiveImage(
            thumbnail,
            "(max-width: 480px) 100vw, (max-width: 768px) 50vw, 400px",
          )}
          alt={name}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>

  <div class="card-info">
    <span class="card-name">{name}</span>
    {
      (price || !available) && (
        <span class="card-price">
          {price && (
            <span class:list={{ "is-sold": !available }}>${price}</span>
          )}
          {!available && <span class="sold-out">Sold out</span>}
        </span>
      )
    }
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
    background: #fff;
  }

  /* Product photos are cropped to 3:4 on upload (see PHOTO_ASPECT in the
     admin backend), so they fill this box exactly. */
  .card-image {
    aspect-ratio: 3 / 4;
    background: #f5f5f5;
    overflow: hidden;
  }

  .card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-info {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 1.25rem 1.25rem;
  }

  .card-name {
    font-family: "Amatic SC", system-ui, sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .product-card:hover .card-name,
  .product-card:focus-visible .card-name {
    text-decoration: underline;
  }

  .card-price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-family: "Averia Libre", system-ui, sans-serif;
    font-size: 0.95rem;
  }

  .is-sold {
    text-decoration: line-through;
    color: #888;
  }

  .sold-out {
    padding: 0.2rem 0.5rem;
    background: #1a1a1a;
    color: #fff;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }
</style>
