---
import { imageVariant, responsiveImage } from "../../lib/images";
import { renderMarkdown } from "../../lib/markdown";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const products = await getCollection("products");

  return products.map((product) => ({
    params: { sku: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const {
  name,
  category,
  description,
  available,
  images,
  createdAt,
  buyLinkUrl,
} = product.data;

// The main photo is half the page wide on desktop, full width on phones.
const MAIN_SIZES = "(max-width: 768px) 100vw, 600px";
---

<BaseLayout title={`${name} - R. Present`} description={description}>
  <article class="product-detail">
    <div class="product-layout">
      <div class="product-images">
        <div class="main-image">
          {
            images[0] && (
              <img
                {...responsiveImage(images[0], MAIN_SIZES)}
                alt={name}
                fetchpriority="high"
                id="main-product-image"
              />
            )
          }
        </div>

        {
          images.length > 1 && (
            <div class="thumbnail-grid">
              {images.map((image, index) => {
                const full = responsiveImage(image, MAIN_SIZES);
                return (
                  <button
                    type="button"
                    class="thumbnail"
                    aria-label={`Show ${name} view ${index + 1}`}
                    aria-pressed={index === 0 ? "true" : "false"}
                    data-src={full.src}
                    data-srcset={full.srcset ?? ""}
                  >
                    <img
                      src={imageVariant(image, 400)}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                );
              })}
            </div>
          )
        }
      </div>

      <div class="product-info">
        <h1>{name}</h1>
        <p class="category">
          Category: <a href={`/categories/${category}`}>{category}</a>
        </p>

        <div class="description">
          <h2>Description</h2>
          <div class="markdown" set:html={renderMarkdown(description)} />
        </div>

        <div class="availability">
          {
            available ? (
              buyLinkUrl ? (
                <a
                  href={buyLinkUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="buy-link"
                >
                  Buy Now
                </a>
              ) : (
                <p class="available">
                  <strong>Available</strong> - Find us at an{" "}
                  <a href="/markets">upcoming market</a>
                </p>
              )
            ) : (
              <p class="sold-out">
                <strong>Sold</strong>
              </p>
            )
          }
        </div>

        <div class="meta">
          <p class="created-date">
            Created: {
              new Intl.DateTimeFormat("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              }).format(createdAt)
            }
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // Clicking a thumbnail shows that photo in the main image box.
  const main = document.querySelector<HTMLImageElement>("#main-product-image");
  const thumbs = document.querySelectorAll<HTMLButtonElement>(".thumbnail");
  thumbs.forEach((thumb) => {
    thumb.addEventListener("click", () => {
      const { src, srcset } = thumb.dataset;
      if (!main || !src) return;
      if (srcset) main.srcset = srcset;
      else main.removeAttribute("srcset");
      main.src = src;
      thumbs.forEach((t) =>
        t.setAttribute("aria-pressed", t === thumb ? "true" : "false"),
      );
    });
  });
</script>

<style>
  .product-detail {
    max-width: 1200px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    color: #666;
    text-decoration: none;
    margin-bottom: 2rem;
    text-transform: capitalize;
  }

  .back-link:hover {
    color: #333;
  }

  .product-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .product-images {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Product photos are cropped to 3:4 on upload (see PHOTO_ASPECT in the
     admin backend), so they fill these boxes exactly. */
  .main-image {
    position: relative;
    aspect-ratio: 3 / 4;
    background: #f5f5f5;
    border-radius: 8px;
    overflow: hidden;
  }

  .main-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 0.5rem;
  }

  .thumbnail {
    aspect-ratio: 3 / 4;
    padding: 0;
    background: #f5f5f5;
    border-radius: 4px;
    overflow: hidden;
    border: 2px solid transparent;
  }

  .thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail:hover,
  .thumbnail:focus-visible {
    border-color: #333;
  }

  .thumbnail[aria-pressed="true"] {
    border-color: #1a1a1a;
  }

  .product-info h1 {
    font-size: 2.5rem;
    margin: 0 0 1rem 0;
  }

  .category {
    color: #666;
    margin: 0 0 2rem 0;
    text-transform: capitalize;
  }

  .category a {
    color: #333;
    text-decoration: none;
  }

  .category a:hover {
    text-decoration: underline;
  }

  .description {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e0e0e0;
  }

  .description h2 {
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
  }

  .description .markdown {
    line-height: 1.6;
    color: #444;
  }

  .description .markdown :global(p) {
    margin: 0 0 1rem 0;
  }

  .description .markdown :global(:last-child) {
    margin-bottom: 0;
  }

  .availability {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e0e0e0;
  }

  .available {
    color: #2d5f2e;
    margin: 0;
  }

  .available a {
    color: #2d5f2e;
    text-decoration: underline;
  }

  .buy-link {
    display: inline-block;
    background: #1a1a1a;
    color: #fff;
    text-decoration: none;
    padding: 0.75rem 2rem;
    border-radius: 4px;
    font-weight: bold;
    transition: background-color 0.2s;
  }

  .buy-link:hover {
    background: #333;
  }

  .sold-out {
    color: #666;
    margin: 0;
  }

  .meta {
    color: #888;
    font-size: 0.875rem;
  }

  .meta p {
    margin: 0;
  }

  @media (max-width: 768px) {
    .product-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .product-info h1 {
      font-size: 2rem;
    }
  }
</style>
