---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderMarkdown } from "../lib/markdown";

// Text lives in src/content/pages/about.json so the admin can edit it.
const about = await getEntry("pages", "about");
if (!about) throw new Error("Missing src/content/pages/about.json");
---

<BaseLayout
  title="About Us - R. Present"
  description="Independent jeweler creating handcrafted jewelry, made in America"
>
  <article class="about-content">
    <section class="intro col-container">
      <div class="col-1">
        <img src="/images/artist.jpg" alt="About the artist" />
      </div>
      <div class="col-2 bio" set:html={renderMarkdown(about.data.body)} />
    </section>

    <section>
      <h2>Connect With Us</h2>
      <p>Follow our journey and see new creations:</p>
      <ul class="social-links">
        <li>
          <a
            href="https://instagram.com/r.present.s"
            target="_blank"
            rel="noopener">Instagram</a
          >
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .about-content {
    margin: 0 auto;
  }

  .col-container {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    max-width: 100%;
  }

  .col-container .col-1 {
    flex-basis: 45%;
  }

  .col-container .col-1 img {
    width: 100%;
  }
  .col-container .col-2 {
    flex-basis: 45%;
  }

  h1 {
    font-size: 2.5rem;
    margin: 0 0 2rem 0;
  }

  /* .bio's markup comes from Markdown, so its tags need :global(). */
  h2,
  .bio :global(h2) {
    font-size: 1.75rem;
    margin: 2rem 0 1rem 0;
  }

  section {
    margin-bottom: 2rem;
  }

  p,
  .bio :global(p) {
    line-height: 1.6;
    color: #444;
    margin: 1rem 0;
  }

  .social-links {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }

  .social-links li {
    margin: 0.5rem 0;
  }

  .social-links a {
    color: #333;
    font-size: 1.125rem;
    text-decoration: none;
  }

  .social-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .col-container {
      display: block;
    }
  }
</style>
