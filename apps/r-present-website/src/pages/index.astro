---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatShortMarketDate, getUpcomingMarkets } from "../lib/markets";
import { getPublishedProducts } from "../lib/products";
import { getProjectsByIndex } from "../lib/projects";

// Get unique categories from products
const products = await getPublishedProducts();
const categories = [...new Set(products.map((p) => p.data.category))].sort();

const upcomingMarkets = await getUpcomingMarkets(3);
const projects = await getProjectsByIndex();
---

<BaseLayout
  title="R. Present - Handcrafted Jewelry"
  backgroundImageUrl="/images/background.jpg"
>
  <div class="hero">
    <h1>Representing</h1>
    <p>Jewelry Lab | Seattle</p>
  </div>

  {
    projects.length > 0 && (
      <section class="projects">
        {projects.map((project) => (
          <div class="project">
            <a class="project-link" href={`/projects/${project.id}`}>
              <h2>{project.data.name}</h2>
            </a>
          </div>
        ))}
      </section>
    )
  }

  <section class="quick-links">
    <div class="link-card">
      <h2><a class="text-link" href="/markets">Upcoming Markets</a></h2>
      {
        upcomingMarkets.length > 0 ? (
          <ul class="market-list">
            {upcomingMarkets.map((market) => (
              <li>
                <span class="market-date">
                  {formatShortMarketDate(market.data.date)} ·{" "}
                  {market.data.timeDescription}
                </span>
                <span class="market-name">{market.data.name}</span>
                <span class="market-details">{market.data.location}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p>No markets scheduled right now. Check back soon!</p>
        )
      }
    </div>

    <div class="link-card">
      <h2>Shop by Category</h2>
      <ul class="category-list">
        {
          categories.map((category) => (
            <li>
              <a href={`/categories/${category}`}>{category}</a>
            </li>
          ))
        }
      </ul>
      {categories.length === 0 && <p>Categories coming soon</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0;
    border-bottom: 1px solid #e0e0e0;
    margin-bottom: 3rem;
    background-repeat: no-repeat;
  }

  .hero h1 {
    font-size: 3rem;
    margin: 0 0 0 0;
    font-weight: 300;
  }

  .hero p {
    /* Only as wide as its text; .hero's text-align centers it. */
    display: inline-block;
    font-size: clamp(1.125rem, 1rem + 1vw, 1.5rem);
    background: black;
    color: white;
    padding: 0 80px;
    margin: 20px 0;
  }

  .projects {
    margin: 40px 0;
    padding: 20px;
  }

  .project {
    display: flex;
    flex-direction: column;
  }

  .project h2 {
    margin: 0;
    font-size: 2rem;
  }

  .project-link,
  .project-link:visited {
    align-self: flex-end;
    color: black;
    text-decoration: none;
    border-bottom: 1px solid #d15128;
    padding-bottom: 2px;
  }

  .tagline {
    font-size: 1.25rem;
    color: #666;
    margin: 0;
  }

  .quick-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .link-card {
    border: 1px solid #e0e0e0;
    padding: 2rem;
    background: #fafafa;
  }

  .link-card h2 {
    margin: 0 0 1rem 0;
    font-size: 1.5rem;
  }

  .link-card p {
    margin: 0 0 1.5rem 0;
    color: #666;
  }

  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: #333;
    color: white;
    text-decoration: none;
    font-weight: bold;
  }

  .button:hover {
    background: #555;
  }

  /* Plain black link: no purple once visited, underline only on hover. */
  .text-link,
  .text-link:visited {
    color: black;
    text-decoration: none;
    cursor: pointer;
  }

  .text-link:hover {
    text-decoration: underline;
  }

  .market-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .market-list li {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0;
    border-top: 1px solid #e0e0e0;
  }

  .market-list li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .market-date {
    font-size: 0.875rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #333;
  }

  .market-name {
    font-size: 1.125rem;
  }

  .market-details {
    font-size: 0.875rem;
    color: #666;
  }

  .category-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .category-list li {
    margin: 0.5rem 0;
  }

  .category-list a {
    text-decoration: none;
    color: #333;
    text-transform: capitalize;
    font-size: 1.125rem;
  }

  .category-list a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2rem;
    }

    .quick-links {
      grid-template-columns: 1fr;
    }
  }
</style>
