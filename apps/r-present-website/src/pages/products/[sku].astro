---
import ProductGallery from "../../components/ProductGallery.astro";
import { renderMarkdown } from "../../lib/markdown";
import { formatShortMarketDate, getUpcomingMarkets } from "../../lib/markets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const products = await getCollection("products");

  return products.map((product) => ({
    params: { sku: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { name, description, available, images, buyLinkUrl } = product.data;

// Where to find a piece that's for sale in person. "Upcoming" means as of
// the last site build.
const markets = available && !buyLinkUrl ? await getUpcomingMarkets(3) : [];

// The main photo is half the page wide on desktop, full width on phones.
const MAIN_SIZES = "(max-width: 768px) 100vw, 600px";
---

<BaseLayout title={`${name} - R. Present`} description={description}>
  <article class="product-detail">
    <div class="product-layout">
      <h1>{name}</h1>

      <div class="product-images">
        <ProductGallery images={images} name={name} sizes={MAIN_SIZES} />
      </div>

      <div class="product-info">
        <div class="description">
          <div class="markdown" set:html={renderMarkdown(description)} />
        </div>

        <div class="availability">
          {
            available ? (
              buyLinkUrl ? (
                <a
                  href={buyLinkUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="buy-link"
                >
                  Buy Now
                </a>
              ) : (
                <div class="available">
                  {markets.length > 0 ? (
                    <>
                      <p>
                        <strong>Available</strong> at our upcoming markets:
                      </p>
                      <ul class="market-list">
                        {markets.map(({ data: market }) => (
                          <li>
                            <span class="market-date">
                              {formatShortMarketDate(market.date)} ·{" "}
                              {market.timeDescription}
                            </span>
                            {market.url ? (
                              <a
                                class="market-name"
                                href={market.url}
                                target="_blank"
                                rel="noopener"
                              >
                                {market.name}
                              </a>
                            ) : (
                              <span class="market-name">{market.name}</span>
                            )}
                            <span class="market-location">
                              {market.location}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : (
                    <p>
                      <strong>Available</strong> in person. No markets are
                      scheduled right now; check back soon!
                    </p>
                  )}
                </div>
              )
            ) : (
              <p class="sold-out">
                <strong>Sold</strong>
              </p>
            )
          }
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .product-detail {
    max-width: 1200px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    color: #666;
    text-decoration: none;
    margin-bottom: 2rem;
    text-transform: capitalize;
  }

  .back-link:hover {
    color: #333;
  }

  /* Desktop: photos on the left, name over the details on the right.
     Mobile (below): name, then photos, then details. One h1 either way. */
  .product-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "images name"
      "images info";
    column-gap: 3rem;
  }

  .product-layout h1 {
    grid-area: name;
  }

  .product-info {
    grid-area: info;
  }

  .product-images {
    grid-area: images;
    min-width: 0;
  }

  h1 {
    font-size: 2.5rem;
    margin: 0 0 1.5rem 0;
  }

  .description {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e0e0e0;
  }

  .description .markdown {
    line-height: 1.6;
    color: #444;
  }

  .description .markdown :global(p) {
    margin: 0 0 1rem 0;
  }

  .description .markdown :global(:last-child) {
    margin-bottom: 0;
  }

  .availability {
    margin-bottom: 2rem;
  }

  .available p {
    margin: 0;
  }

  .available strong {
    color: #2d5f2e;
  }

  .market-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    border-top: 1px solid #1a1a1a;
  }

  .market-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid #1a1a1a;
  }

  .market-date {
    font-size: 0.875rem;
    color: #666;
  }

  .market-name {
    font-weight: bold;
  }

  a.market-name:hover {
    text-decoration: underline;
  }

  .market-location {
    font-size: 0.875rem;
    color: #444;
  }

  .buy-link {
    display: inline-block;
    background: #1a1a1a;
    color: #fff;
    text-decoration: none;
    padding: 0.75rem 2rem;
    font-weight: bold;
    transition: background-color 0.2s;
  }

  .buy-link:hover {
    background: #333;
  }

  .sold-out {
    color: #666;
    margin: 0;
  }

  @media (max-width: 768px) {
    .product-layout {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      grid-template-areas:
        "name"
        "images"
        "info";
    }

    .product-images {
      margin-bottom: 2rem;
    }

    h1 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }
  }
</style>
