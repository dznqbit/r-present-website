# Local settings for `npm run dev`. Copy to .env (gitignored) and fill in.
# Leave the photo settings out to save uploads in .uploads/ on this machine.

# Photo uploads to Cloudflare R2, using the dev token (R2 → Manage API tokens).
# dev/ keeps test photos apart from real ones.
S3_BUCKET=r-present-images
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PREFIX=dev/
IMAGES_BASE_URL=https://images.r-present.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
