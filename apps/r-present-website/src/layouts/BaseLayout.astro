---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  backgroundImageUrl?: string;
}

const {
  title,
  description = "Handcrafted jewelry, made in America",
  backgroundImageUrl = null,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body style={`--background-image-url: url("${backgroundImageUrl}")`}>
    <div id="hammer-cursor">
      <img src="/images/hammer.png" alt="" />
    </div>
    <div id="hammer-impact"><img src="" alt="" /></div>

    <header>
      <nav>
        <div class="site-title">
          <a href="/" title="Home"
            ><img src="/images/logo.png" height="72" alt="R. Present" /></a
          >
        </div>
        <ul>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/categories">Shop</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} R. Present. All rights reserved.</p>
      <div class="social-links">
        <a
          href="https://instagram.com/r.present.s"
          target="_blank"
          rel="noopener">Instagram</a
        >
      </div>
    </footer>
  </body>
</html>

<script>
  const DEFAULT_CURSOR_SRC = "/images/hammer.png";
  const ACTIVE_CURSOR_SRC = "/images/hammer-strike.png";
  const IMPACT_SRCS = [
    "/images/strike-1.png",
    "/images/strike-2.png",
    "/images/strike-3.png",
    "/images/strike-4.png",
  ];
  const IMPACT_DURATION_MS = 200;

  const cursor = document.getElementById("hammer-cursor");
  const cursorImage = cursor?.querySelector("img");
  const impact = document.getElementById("hammer-impact");
  const impactImage = impact?.querySelector("img");
  let impactTimeoutId: ReturnType<typeof setTimeout> | undefined;

  const isCoarsePointer = window.matchMedia("(pointer: coarse)").matches;

  if (cursor && cursorImage) {
    document.addEventListener("mousemove", (event) => {
      cursor.style.left = `${event.clientX}px`;
      cursor.style.top = `${event.clientY}px`;
      cursor.classList.add("is-visible");
    });

    document.addEventListener("mousedown", (event) => {
      event.preventDefault();
      cursorImage.src = ACTIVE_CURSOR_SRC;

      if (impact && impactImage) {
        const src = IMPACT_SRCS[Math.floor(Math.random() * IMPACT_SRCS.length)];

        impactImage.src = src;
        impact.style.left = `${event.clientX}px`;
        impact.style.top = `${event.clientY}px`;
        impact.classList.add("is-visible");

        clearTimeout(impactTimeoutId);
        impactTimeoutId = setTimeout(() => {
          impact.classList.remove("is-visible");
        }, IMPACT_DURATION_MS);
      }
    });

    document.addEventListener("mouseup", () => {
      cursorImage.src = DEFAULT_CURSOR_SRC;

      if (isCoarsePointer) {
        cursor.classList.remove("is-visible");
      }
    });
  }
</script>

<style is:global>
  /* Links are black, visited or not, unless a component colors them.
     :where() keeps this at zero specificity so any component rule wins, and
     any author rule beats the browser's blue/purple. */
  :where(a) {
    color: #1a1a1a;
  }
</style>

<style>
  body,
  a,
  button {
    cursor: none;
  }

  #hammer-cursor {
    /* hammer.png is 800x1400; the striking face sits ~77% across, ~16% down */
    --cursor-height: 120px;
    --cursor-width: calc(var(--cursor-height) * 800 / 1400);
    --tip-x: calc(var(--cursor-width) * 0.2);
    --tip-y: calc(var(--cursor-height) * 0.2);

    position: fixed;
    top: 0;
    left: 0;
    width: var(--cursor-width);
    height: var(--cursor-height);
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    transform: translate(calc(-1 * var(--tip-x)), calc(-1 * var(--tip-y)));
    -webkit-user-select: none;
    user-select: none;
  }

  #hammer-cursor.is-visible {
    opacity: 1;
  }

  #hammer-cursor img {
    display: block;
    width: 100%;
    height: 100%;
  }

  #hammer-impact {
    position: fixed;
    top: 0;
    left: 0;
    width: 60px;
    height: 60px;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    opacity: 0;
    -webkit-user-select: none;
    user-select: none;
  }

  #hammer-impact.is-visible {
    opacity: 1;
  }

  #hammer-impact img {
    display: block;
    width: 100%;
    height: 100%;
  }

  body {
  }

  header {
    padding: 1rem;
  }

  /* Logo centered on top, links spread evenly across the row below. */
  nav {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
  }

  .site-title {
    text-align: center;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: bold;
    color: #333;
    text-decoration: none;
    background-image: url("/images/logo.png");
  }

  /* Capped at 800px so the links don't drift apart on wide monitors. */
  nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 80px;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 0;
  }

  /* Scales with the screen: 1.125rem on phones up to 1.5rem on desktop. */
  nav a {
    text-decoration: none;
    color: #333;
    font-size: clamp(1.125rem, 1rem + 1vw, 1.5rem);
  }

  nav a:hover {
    color: #666;
  }

  main {
    background-image: var(--background-image-url);
    background-size: 50em;
    background-repeat: repeat-y;
    background-position: 0em 0em;

    flex: 1;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  footer {
    background: #f8f8f8;
    border-top: 1px solid #e0e0e0;
    padding: 2rem 1rem;
    text-align: center;
  }

  .social-links {
    margin-top: 1rem;
  }

  .social-links a {
    margin: 0 0.5rem;
    color: #333;
    text-decoration: none;
  }

  .social-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    main {
      background-size: 20em;
    }

    .site-title {
      text-align: left;
    }

    /* 30% smaller than the 72px desktop logo. */
    .site-title img {
      height: 50px;
      width: auto;
    }
  }
</style>
