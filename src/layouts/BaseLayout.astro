---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  backgroundImageUrl?: string;
}

const {
  title,
  description = "Handcrafted jewelry, made in America",
  backgroundImageUrl = null,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body style={`--background-image-url: url("${backgroundImageUrl}")`}>
    <header>
      <nav>
        <div>
          <a href="/" title="Home"
            ><img src="/images/logo.png" height="64" alt="R. Present" /></a
          >
        </div>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/categories">Merch</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} R. Present. All rights reserved.</p>
      <div class="social-links">
        <a
          href="https://instagram.com/r.present.s"
          target="_blank"
          rel="noopener">Instagram</a
        >
      </div>
    </footer>
  </body>
</html>

<style>
  body {
    background-image: var(--background-image-url);
    background-size: 50% auto;
    background-repeat: repeat-y;
    background-position: top left;
  }

  header {
    padding: 1rem;
  }

  nav {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: bold;
    color: #333;
    text-decoration: none;
    background-image: url("/images/logo.png");
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
    color: #333;
  }

  nav a:hover {
    color: #666;
  }

  main {
    flex: 1;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  footer {
    background: #f8f8f8;
    border-top: 1px solid #e0e0e0;
    padding: 2rem 1rem;
    text-align: center;
  }

  .social-links {
    margin-top: 1rem;
  }

  .social-links a {
    margin: 0 0.5rem;
    color: #333;
    text-decoration: none;
  }

  .social-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    nav {
      flex-direction: column;
      align-items: flex-start;
    }

    nav ul {
      flex-wrap: wrap;
      gap: 1rem;
    }
  }
</style>
